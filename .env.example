# ═══════════════════════════════════════════════════════════════════
# ResearchMind — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API keys:
#   cp .env.example .env
#
# All values below are either REQUIRED or show their defaults.
# ═══════════════════════════════════════════════════════════════════

# ── Required API Keys ─────────────────────────────────────────────
# Get your Groq API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Get your Tavily API key at: https://app.tavily.com/home
TAVILY_API_KEY=your_tavily_api_key_here

# ── Model Configuration ──────────────────────────────────────────
# Groq model identifier (see: https://console.groq.com/docs/models)
# MODEL_NAME=llama-3.1-8b-instant

# LLM temperature: 0.0 = deterministic, higher = more creative
# MODEL_TEMPERATURE=0.0

# ── Search Configuration ─────────────────────────────────────────
# Number of Tavily search results to return (1-20)
# SEARCH_MAX_RESULTS=5

# ── Scraping Configuration ───────────────────────────────────────
# Maximum characters to extract per scraped page
# SCRAPE_MAX_CHARS=3000

# HTTP timeout in seconds for scraping requests
# SCRAPE_TIMEOUT=10

# Number of URLs to scrape in parallel (1-10)
# SCRAPE_PARALLEL_COUNT=3

# Retry attempts for failed scrapes (0-5)
# SCRAPE_RETRY_ATTEMPTS=2

# ── Cache Configuration ──────────────────────────────────────────
# Enable/disable disk caching for search and scrape results
# CACHE_ENABLED=true

# Cache TTL for search results in seconds (default: 10 minutes)
# CACHE_SEARCH_TTL_SECONDS=600

# Cache TTL for scraped pages in seconds (default: 30 minutes)
# CACHE_SCRAPE_TTL_SECONDS=1800
